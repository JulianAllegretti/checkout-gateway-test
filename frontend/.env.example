# Copy to .env.local and fill in real values locally. Never commit .env*.
# These are consumed by the browser bundle (Vite's VITE_ prefix) — only ever put
# public/publishable values here, never a secret key.

# The payment gateway's sandbox API base URL and public (tokenization) key —
# generic names on purpose, see specs/decisions/0001-architecture-overview.md.
VITE_PAYMENT_API_URL="https://api-sandbox.example-gateway.dev/v1"
VITE_PAYMENT_PUBLIC_KEY="pub_test_changeme"

VITE_SENTRY_DSN=
