# Copy to .env and fill in real values locally. Never commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checkout?schema=public"

PAYMENT_API_URL="https://api-sandbox.example-gateway.dev/v1"
PAYMENT_PRIVATE_KEY="changeme"
# Not a secret (same value the frontend would otherwise use directly), but the
# gateway's merchant-info endpoint has no browser CORS support, so the backend
# fetches the acceptance tokens on the frontend's behalf — see PaymentController.
PAYMENT_PUBLIC_KEY="changeme"
PAYMENT_INTEGRITY_SECRET="changeme"

BASE_FEE_AMOUNT=5000
DELIVERY_FEE_AMOUNT=8000

PORT=3000
LOG_LEVEL=info
SENTRY_DSN=
