{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Keeps the incremental build cache inside dist/, so nest-cli.json's
    // deleteOutDir wipes it along with the output on every build. Otherwise the
    // cache survives a deleted dist/ and tsc thinks a wiped build is already
    // up to date, silently emitting nothing.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
