# Copy to .env.test locally. Overrides just DATABASE_URL from .env — everything
# else (payment gateway keys, fees, etc.) test files set for themselves where they
# need it, see test-setup.ts.
#
# A separate database from .env's is required: the Prisma integration tests
# (product.repository.prisma.spec.ts, transaction.repository.prisma.spec.ts)
# truncate every table in `beforeEach`. Pointing this at the same database as
# .env would wipe your local dev data every time you run the test suite.
#
# One-time setup against the docker-compose Postgres: `npm run db:test:setup`
# (creates the `checkout_test` database if missing and applies migrations to it).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checkout_test?schema=public"
